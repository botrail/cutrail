ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Shape Data from Truck'), '2;1');
FILE_NAME('', '2026-11-12T00:00:00Z', (('')), (('')), 'truck', '', '');
FILE_SCHEMA(('ISO-10303-042'));
ENDSEC;
DATA;
#1 = APPLICATION_PROTOCOL_DEFINITION('international standard', 'automotive_design', 2000, #2);
